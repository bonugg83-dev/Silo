{
  "manifest_version": 3,
  "name": "마이픽 전자도서 교정 도우미",
  "version": "0.5.0",
  "description": "마이픽 전자도서 제작 화면에서 원본 이미지를 보고 Claude가 쪽 텍스트를 교정해 줍니다.",
  "permissions": [
    "sidePanel",
    "storage",
    "scripting",
    "tabs",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://www.mypickebook.org/*",
    "https://mypickebook.org/*",
    "http://www.mypickebook.org/*",
    "http://mypickebook.org/*",
    "https://api.anthropic.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "마이픽 교정 도우미 열기"
  },
  "icons": {
    "128": "icon128.png"
  }
}
