{
  "manifest_version": 3,
  "name": "Silo",
  "version": "0.0.0",
  "description": "테스트 전용: Silo 앱(app/)을 크롬에 올려 브라우저 테스트를 돌리기 위한 매니페스트 (배포하지 않음)",
  "permissions": [
    "sidePanel",
    "storage",
    "scripting",
    "tabs",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://www.mypickebook.org/*",
    "https://mypickebook.org/*",
    "http://www.mypickebook.org/*",
    "http://mypickebook.org/*",
    "https://api.anthropic.com/*",
    "https://identitytoolkit.googleapis.com/*",
    "https://securetoken.googleapis.com/*",
    "https://firestore.googleapis.com/*"
  ],
  "background": {
    "service_worker": "harness-sw.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
