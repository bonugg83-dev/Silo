{
  "name": "silo-desktop",
  "productName": "Silo",
  "version": "0.3.1",
  "description": "Silo 데스크톱 앱: 확장(../extension)을 그대로 Electron 창 안에서 실행",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node test/e2e.mjs && node test/e2e-accounts.mjs && node test/e2e-popups.mjs && node test/e2e-update.mjs",
    "dist:win": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "release:win": "electron-builder --win --publish always"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "dependencies": {
    "electron-updater": "6.3.9"
  },
  "build": {
    "appId": "org.silo.desktop",
    "productName": "Silo",
    "copyright": "Copyright (C) 2026 Silo",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "updater.js",
      "preload-*.js",
      "ui/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../extension",
        "to": "extension"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "Silo-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Silo",
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.productivity"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "bonugg83-dev",
        "repo": "Silo",
        "releaseType": "release"
      }
    ]
  }
}
